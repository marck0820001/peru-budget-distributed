{
  "info": {
    "name": "PeruBudget PC4 - API distribuida TCP",
    "description": "Ejecutar en orden. El entrenamiento es asincrono: repetir item 04 hasta succeeded, luego item 05. API local, no expuesta a Internet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Health (<100ms)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Latencia objetivo <100ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Nodos TCP",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/cluster/nodes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "cluster",
            "nodes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Dos nodos registrados\", () => pm.expect(pm.response.json().nodes.length).to.equal(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Iniciar entrenamiento (guarda job_id)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"k\": 3,\n  \"seed\": 42,\n  \"max_iterations\": 25\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/train",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "train"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
              "if (pm.response.code === 202) pm.collectionVariables.set(\"job_id\", pm.response.json().job_id);",
              "pm.test(\"Job id presente\", () => pm.expect(pm.response.json().job_id).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar job (repetir hasta succeeded)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/jobs/{{job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "jobs",
            "{{job_id}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Latencia objetivo <100ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));",
              "console.log(\"Estado:\", pm.response.json().status);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Obtener resultado (solo si succeeded)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/v1/jobs/{{job_id}}/result",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "jobs",
            "{{job_id}}",
            "result"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 al finalizar\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data=pm.response.json();",
              "  pm.test(\"Tres clusters\", () => pm.expect(data.cluster_sizes.length).to.equal(3));",
              "  console.log(\"Inercia:\", data.inertia, \"Filas:\", data.rows);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - OpenAPI YAML",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/openapi.yaml",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "openapi.yaml"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Swagger UI",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/docs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "docs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "job_id",
      "value": ""
    }
  ]
}
